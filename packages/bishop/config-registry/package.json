{
	"name": "@bishop/config-registry",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js",
			"default": "./dist/node.js"
		},
		"./vite": {
			"types": "./dist/vite-plugin.d.ts",
			"import": "./dist/vite-plugin.js",
			"default": "./dist/vite-plugin.js"
		}
	},
	"bin": {
		"config-registry": "bin/config.mjs"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"vitest": "^4.1.0"
	}
}
